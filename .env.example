# Network configuration
# Options: local, testnet, mainnet
STELLAR_NETWORK=testnet

# For local network
STELLAR_LOCAL_RPC_URL=http://localhost:8000/soroban/rpc

# For testnet
STELLAR_TESTNET_RPC_URL=https://horizon-testnet.stellar.org
STELLAR_TESTNET_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# For mainnet
STELLAR_MAINNET_RPC_URL=https://horizon.stellar.org
STELLAR_MAINNET_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# Account information (KEEP SECRET - never commit this file!)
# Get testnet XLM from: https://www.stellar.org/developers/learn/tools/laboratory/
STELLAR_SECRET_KEY=
STELLAR_PUBLIC_KEY=

# Contract addresses (set after deployment)
# These will be populated after running deployment scripts
CONTRACT_ID=

# Frontend configuration
REACT_APP_STELLAR_NETWORK=${STELLAR_NETWORK}
REACT_APP_CONTRACT_ID=${CONTRACT_ID}
